# SlideGuard Environment Configuration

# LLM Configuration
SLIDEGUARD_LLM_API_KEY=token-abc123
SLIDEGUARD_LLM_API_BASE=http://d.dgx:8728/v1
SLIDEGUARD_LLM_MODEL=/model

# Cache Configuration (optional)
SLIDEGUARD_CACHE_DIR=.slideguard_cache
SLIDEGUARD_FILE_CACHE_DIR=.file_cache

# Model Configuration (optional)
SLIDEGUARD_MAX_CONCURRENCY=8
# if using openai instead of the local model
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# DB config
AUTH_DB_URL=sqlite:///./auth.db