# SlideGuard Environment Configuration

# LLM Configuration (for local/custom OpenAI-compatible endpoints)
SLIDEGUARD_LLM_API_KEY=token-abc123
SLIDEGUARD_LLM_API_BASE=http://d.dgx:8728/v1
SLIDEGUARD_LLM_MODEL=/model

# Anthropic Configuration (optional, takes priority over OpenAI if set)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI Configuration (optional, takes priority over local endpoint if set)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Cache Configuration (optional)
SLIDEGUARD_CACHE_DIR=.slideguard_cache
SLIDEGUARD_FILE_CACHE_DIR=.file_cache
