POSTGRES_USER=slideguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=slideguard
AUTH_DB_URL=

UI_HOST=0.0.0.0
UI_PORT=7860

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=admin

SLIDEGUARD_LLM_API_KEY=change_me
SLIDEGUARD_LLM_API_BASE=http://host.docker.internal:8000/v1
SLIDEGUARD_LLM_MODEL=/model
SLIDEGUARD_MAX_CONCURRENCY=8

SLIDEGUARD_CACHE_DIR=/app/.slideguard_cache
SLIDEGUARD_FILE_CACHE_DIR=/app/.file_cache

SLIDEGUARD_USE_LANGFUSE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_SCHEDULE_DELAY=5000

# Optional: setup custom fonts
SLIDEGUARD_REPORT_FONT_REGULAR=
SLIDEGUARD_REPORT_FONT_BOLD=


