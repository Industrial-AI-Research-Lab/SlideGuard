FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UI_HOST=0.0.0.0 \
    UI_PORT=7860 \
    SLIDEGUARD_USE_LANGFUSE=0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry==2.1.3

COPY pyproject.toml poetry.lock README.md ./
RUN poetry config virtualenvs.create false && \
    poetry install --no-interaction --no-ansi --no-root

COPY . .
RUN poetry install --no-interaction --no-ansi

CMD poetry run python deploy/bootstrap_admin.py && EXTRA=""; if [ "${SLIDEGUARD_USE_LANGFUSE}" = "1" ] || [ "${SLIDEGUARD_USE_LANGFUSE}" = "true" ] || [ "${SLIDEGUARD_USE_LANGFUSE}" = "yes" ] || [ "${SLIDEGUARD_USE_LANGFUSE}" = "on" ]; then EXTRA="--use-langfuse"; fi; poetry run python -m slideguard.main ui run --host ${UI_HOST} --port ${UI_PORT} --auth --no-share --no-debug --hide-error --quiet --hide-api ${EXTRA}